# Copy to .env and fill with your own values. Never commit .env, cookies, QR files, or session files.

PORT=4001
# Optional comma-separated HTTP prefixes, for example /bridge-a,/bridge-b.
HTTP_ROUTE_PREFIXES=

# Chatwoot
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_API_TOKEN=REPLACE_WITH_CHATWOOT_ACCESS_TOKEN_
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_INBOX_IDENTIFIER=replace_with_api_inbox_identifier

# Optional namespacing when running more than one bridge.
CHATWOOT_INSTANCE_KEY=zalo
CHATWOOT_CONTACT_IDENTIFIER_PREFIX=zalo:
CHATWOOT_CONTACT_IDENTIFIER_LEGACY_PREFIXES=
CHATWOOT_SOURCE_ID_PREFIX=zalo:

# Zalo personal session. Use npm run login:qr to populate cookie/session values.
ZALO_IMEI=replace_with_device_imei_or_generated_stable_id
ZALO_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:133.0) Gecko/20100101 Firefox/133.0"
ZALO_LANGUAGE=vi
ZALO_COOKIE_JSON=REPLACE_WITH_ZALO_COOKIE_JSON_ARRAY_
ZALO_SESSION_FILE=./data/session.json
ZALO_OUTBOUND_QUEUE_FILE=./data/outbound-queue/queue.json
# Optional account guard. Set privately after verifying the authenticated account; never commit a real UID.
ZALO_EXPECTED_SELF_UID=
# Optional listener recovery deadline in milliseconds (default 90000; range 10000-900000).
ZALO_LISTENER_RECOVERY_TIMEOUT_MS=90000
ZALO_MENTIONS_CONFIG_FILE=./data/zalo-mentions.json
