{
  "name": "chatwoot-zalo-personal-bridge",
  "version": "0.1.0",
  "description": "Unofficial bridge between a Zalo personal account and a Chatwoot API inbox",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "login:qr": "ts-node scripts/login-qr.ts",
    "import:browser-session": "ts-node scripts/import-browser-session.ts",
    "test": "npm run test:zalo-mentions && npm run test:actionlist-system",
    "test:zalo-mentions": "ts-node scripts/test-zalo-mentions.ts",
    "test:actionlist-system": "ts-node scripts/test-actionlist-system.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@warriorteam/zalo-personal": "^1.4.1",
    "axios": "^1.7.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "form-data": "^4.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/form-data": "^2.5.0",
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
